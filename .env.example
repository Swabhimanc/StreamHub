# Optional — a read-only TMDB key is built into src/api/tmdb.js already.
# Set this only to point builds at your own key.
# Free key: https://www.themoviedb.org/signup -> Settings -> API (v3 auth key)
VITE_TMDB_API_KEY=

# Watch party WebSocket server (Cloudflare Worker + Durable Objects).
# Deploy the worker in server/ (wrangler deploy), then set its wss:// URL here.
# Omit to fall back to ws://localhost:8787 (run `npx wrangler dev` in server/).
VITE_PARTY_WS_URL=
